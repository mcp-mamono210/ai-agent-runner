{
  "name": "ai-agent-runner",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test:unit": "npm run build && node --test dist/tests/unit/*.test.js",
    "verify:phase49:s3": "npm run build && node dist/src/verification/phase49-real-s3.js",
    "test:integration:phase49": "npm run build && node --test dist/tests/integration/phase49-s3-compatible.test.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "eslint": "10.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
