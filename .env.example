# Phase 48-1 Controller polling boundary.
AGENT_RUNNER_ALLOWED_PROJECTS=414
AGENT_RUNNER_POLL_INTERVAL_MS=30000

# Redmine read/write credentials stay Controller-side and are never Agent input.
REDMINE_URL=https://redmine.example.test
REDMINE_API_KEY=replace-with-read-key
REDMINE_WRITE_API_KEY=replace-with-write-key
# Optional. Defaults to 10000.
REDMINE_TIMEOUT_MS=10000

# Environment-specific numeric binding used only to make the list query bounded.
# Canonical lifecycle/rejection mappings are still resolved by exact field name
# from each re-fetched Issue and are not hard-coded by numeric ID.
AGENT_RUNNER_BRIEF_LIFECYCLE_FIELD_ID=REPLACE_WITH_ENVIRONMENT_SPECIFIC_ID

# Reuse the Phase 37 Agent Brief persistence configuration. The repository root
# is a local read-only Git checkout/mirror used to verify the exact approved
# canonical-branch Brief blob; no source checkout/network access occurs here.
AGENT_BRIEF_REPOSITORY_ROOT=/absolute/path/to/redmine
AGENT_BRIEF_REPOSITORY=mcp-mamono210/redmine
AGENT_BRIEF_CANONICAL_BRANCH=main
AGENT_BRIEF_REQUIREMENT_CUSTOM_FIELD_IDS=

# Phase 48-2 repository-access policy. Missing configuration fails closed;
# an explicitly empty value is a valid empty allowlist.
# Format per entry:
# repository|remote_url|source_ref|username_env|password_env
# Multiple entries are separated by semicolons. Repository comparison is exact;
# only configured entry ASCII edge whitespace is removed before comparison.
AGENT_RUNNER_REPOSITORY_CONFIG=mcp-mamono210/redmine|https://github.com/mcp-mamono210/redmine.git|refs/heads/main|AGENT_RUNNER_GIT_USERNAME|AGENT_RUNNER_GIT_READ_TOKEN

# Controller-owned read-only repository credential. These values are consumed
# only after the early repository allowlist pre-check succeeds and are never
# passed to the Agent or written as durable execution state.
AGENT_RUNNER_GIT_USERNAME=x-access-token
AGENT_RUNNER_GIT_READ_TOKEN=replace-with-read-only-token
