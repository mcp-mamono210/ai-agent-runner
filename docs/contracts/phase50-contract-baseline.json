  "executionLifecycles": [
    "Ready for Agent",
    "Agent Running",
    "Ready for Independent Verification",
    "Needs Human"
  ],
  "executionOutcomes": [
    "changes_ready",
    "no_changes",
    "stale_requirements",
    "eligibility_failed",
    "interrupted",
    "timeout",
    "agent_start_failed",
    "agent_failed",
    "artifact_persistence_failed"
  ],
  "artifact": {
    "formatVersion": "phase49.single.v1",
    "singleObject": true,
    "envelopeRequiredKeys": [
      "manifest",
      "patch"
    ],
    "manifestRequiredKeys": [
      "artifactFormatVersion",
      "briefRevision",
      "changedFiles",
      "executionId",
      "issueId",
      "outcome",
      "patch",
      "persistedRevision",
      "repository",
      "requirementsFingerprint",
      "sourceRevision"
    ],
    "metadataRequiredKeys": [
      "artifact-format-version",
      "execution-id",
      "issue-id",
      "repository",
      "source-revision",
      "brief-revision",
      "persisted-revision",
      "requirements-fingerprint",
      "outcome",
      "patch-checksum"
    ],
    "metadataKeyRule": "lowercase-kebab-case",
    "patchFormat": "git-diff-binary-v1",
    "patchChecksumAlgorithm": "sha256",
    "s3ChecksumAlgorithm": "SHA256",
    "s3ChecksumType": "FULL_OBJECT",
    "maximumArtifactSizeBytes": 8388608,
    "uploadMode": "direct PutObject",
    "conditionalWrite": "If-None-Match:*",
    "deterministicObjectKey": "{prefix}/{execution_id}.json",
    "serverSideEncryption": "AES256"
  },
  "iam": {
    "requiredControllerActions": [
      "s3:PutObject",
      "s3:GetObject"
    ],
    "notRequiredControllerActions": [
      "s3:DeleteObject",
      "s3:ListBucket"
    ]
  }
}
